{
  "manifest_version": 3,
  "name": "PrettyCopy — AI 文本漂亮复制",
  "version": "0.2.0",
  "description": "将任意 Markdown 或普通文本转换为干净的富文本、纯文本或 Markdown。",
  "permissions": [
    "clipboardWrite",
    "storage"
  ],
  "action": {
    "default_title": "打开 PrettyCopy",
    "default_popup": "popup/popup.html"
  }
}
